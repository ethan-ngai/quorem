  "referenceSource": "def solve(text):\n    letters = [c for c in text if c.isascii() and c.isalpha()]\n    return \"\".join(letters.pop() if c.isascii() and c.isalpha() else c for c in text)\nclass Solution:\n    def mirrorLetters(self, text):\n        return solve(text)\n"
