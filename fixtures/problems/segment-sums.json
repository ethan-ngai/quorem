  "referenceSource": "def solve(head):\n    if isinstance(head, list) or head is None:\n        values = head or []\n        out = []; total = 0; active = False\n        for value in values + [0]:\n            if value == 0:\n                if active: out.append(total)\n                total = 0; active = False\n            else: total += value; active = True\n        return out or None\n    from quorem_types import ListNode\n    values = []\n    while head: values.append(head.val); head = head.next\n    values = solve(values) or []\n    dummy = ListNode(); tail = dummy\n    for value in values: tail.next = ListNode(value); tail = tail.next\n    return dummy.next\nclass Solution:\n    def segmentSums(self, head):\n        return solve(head)\n"
