{
  "name": "@quorem/auth",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts",
    "./node": "./src/node-auth.ts",
    "./peer": "./src/peer.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types src/seed.ts",
    "test": "vp test",
    "test:mail": "node --test src/mail-intents.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "email:dev": "email dev --dir emails --port 5300",
    "email:mailpit": "node --experimental-strip-types src/emails/send-previews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@better-auth/passkey": "catalog:",
    "@quorem/contracts": "workspace:*",
    "@quorem/database": "workspace:*",
    "@quorem/execution": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "nodemailer": "10.4.0",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.11.10",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.10",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vitest": "catalog:"
  }
}
