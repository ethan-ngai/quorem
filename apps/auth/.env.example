APP_ENV=local
AUTH_MODE=cognito
AUTH_ORIGIN=http://127.0.0.1:5174
AUTH_PORT=8082
AUTH_DATABASE_URL=postgres://quorem:quorem@127.0.0.1:54329/quorem_auth_test?sslmode=disable
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_INTERNAL_SECRET=replace-with-separate-random-secret
COGNITO_CLIENT_ID=configure-managed-client
COGNITO_CLIENT_SECRET=configure-managed-secret
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USERPOOL_ID=us-east-1_pool

# Private S3 bucket; endpoint and explicit credentials optional on AWS (uses IAM).
AVATAR_S3_ENDPOINT=http://127.0.0.1:53900
AVATAR_S3_REGION=garage
AVATAR_S3_BUCKET=quorem-avatars
AVATAR_S3_ACCESS_KEY_ID=configure-garage-access-key
AVATAR_S3_SECRET_ACCESS_KEY=configure-garage-secret-key

# Passkeys require localhost development or HTTPS DNS origin, never an IP host.
AUTH_PASSKEYS=true
# Optional social providers; set both values in secret environment configuration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET= # Apple signed client-secret JWT
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
