APP_ENV=local
AUTH_MODE=cognito
AUTH_ORIGIN=http://127.0.0.1:5174
AUTH_PORT=8082
# AUTH_HOST=0.0.0.0 # Explicit container listener; restrict internal paths at the proxy
AUTH_DATABASE_URL=postgres://quorem:quorem@127.0.0.1:54329/quorem_auth_test?sslmode=disable
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_INTERNAL_SECRET=replace-with-separate-random-secret
COGNITO_CLIENT_ID=configure-managed-client
COGNITO_CLIENT_SECRET=configure-managed-secret
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1
COGNITO_USERPOOL_ID=us-east-1_pool

# Private S3 bucket; endpoint and explicit credentials optional on AWS (uses IAM).
AVATAR_S3_ENDPOINT=http://127.0.0.1:53900
AVATAR_S3_REGION=garage
AVATAR_S3_BUCKET=quorem-avatars
AVATAR_S3_ACCESS_KEY_ID=configure-garage-access-key
AVATAR_S3_SECRET_ACCESS_KEY=configure-garage-secret-key

# Passkeys require localhost development or HTTPS DNS origin, never an IP host.
AUTH_PASSKEYS=true
# Optional social providers; set both values in secret environment configuration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET= # Apple signed client-secret JWT
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional local account creation; loopback SMTP required (Mailpit mailer profile).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=51025
# SMTP_FROM=Quorem <accounts@quorem.local>

# Capabilities are independent. Existing Garage/SMTP variables remain supported.
# AVATAR_STORAGE_DRIVER=s3 # AWS IAM by default; endpoint supports local Garage
# AVATAR_STORAGE_DRIVER=r2
# AVATAR_R2_ACCOUNT_ID=32-character-cloudflare-account-id
# AVATAR_R2_BUCKET=quorem-avatars
# AVATAR_R2_ACCESS_KEY_ID=
# AVATAR_R2_SECRET_ACCESS_KEY=

# Optional self-managed production credentials: HTTPS plus external mail required.
# AUTH_MODE=password
# AUTH_PASSWORD_PRODUCTION=true
# AUTH_EMAIL_FROM=accounts@example.com
# AUTH_EMAIL_DRIVER=ses-smtp
# AUTH_EMAIL_SES_REGION=us-east-1
# SMTP_USERNAME= # SES SMTP credentials, not AWS access keys
# SMTP_PASSWORD=
# SMTP_PORT=465 # 587 uses required STARTTLS

# Cloudflare outbound Email Service (beta); account entitlement/onboarded domain required.
# AUTH_EMAIL_DRIVER=cloudflare
# AUTH_EMAIL_CLOUDFLARE_ACCOUNT_ID=
# AUTH_EMAIL_CLOUDFLARE_API_TOKEN= # Email Sending permission

# Other transactional SMTP services: explicit AUTH_EMAIL_DRIVER=smtp,
# SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, AUTH_EMAIL_FROM and TLS submission port.
