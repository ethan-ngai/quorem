FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
RUN apt-get update && apt-get install -y --no-install-recommends ocaml=4.13.1-4 && rm -rf /var/lib/apt/lists/*
ENV QUOREM_LANGUAGE=ocaml
COPY apps/runner/polyglot/harness.py /opt/quorem/harness.py
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python3", "-B", "/opt/quorem/harness.py"]
