FROM postgres:17.6-bookworm@sha256:f3bd19c606e442c3d7bdfa8002e03fe260a1023351e0ea4598032022b68dd6e3
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-psycopg2 && rm -rf /var/lib/apt/lists/*
COPY apps/runner/postgres/harness.py /opt/quorem/harness.py
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python3", "-B", "/opt/quorem/harness.py"]
