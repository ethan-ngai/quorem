---
import "@fontsource/silkscreen/latin-400.css";
---
<p class="hero-tagline">Compete <span>beyond</span> the algorithm</p>

<style>
  .hero-tagline {
    margin: 0;
    color: var(--color-text);
    font-family: "Silkscreen", var(--font-interface);
    font-size: clamp(14px, 1.7vw, 24px);
    font-weight: 400;
    font-style: normal;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .hero-tagline span { color: var(--color-primary); }
</style>
