---
interface Props { variant: "tech-stacked" | "factions" | "codebase-clash" | "odyssey" }
const { variant } = Astro.props;
const descriptions = {
  "tech-stacked": "Tech Stacked concept: a failed service is bypassed by connecting a replacement service between a gateway and database. A cursor places another replica.",
  factions: "Factions concept: three separate parties, each with three members, face one another in the same match.",
  "codebase-clash": "Codebase Clash concept: an issue in an existing repository leads to editing a source file, shown as a code diff.",
  odyssey: "Odyssey concept: an Order object grows to include Payment, then Shipment, across three successive rounds, with the lifecycle expanding from New to Paid to Sent.",
};
const parties = [
  { x: 135, y: 83, label: "Your party", active: true },
  { x: 385, y: 83, label: "Party B", active: false },
  { x: 260, y: 248, label: "Party C", active: false },
];
---
<figure class={`match-mode-art upcoming-art art-${variant}`} role="img" aria-label={descriptions[variant]}>
  <svg viewBox="0 0 520 320" fill="none" aria-hidden="true">
    {variant === "tech-stacked" && <>
      <path class="concept-link" d="M139 160h33V87h32m108 0h28v73h30" />
      <path class="concept-route" d="M139 160h33v70h32m108 0h28v-70h30" />
      <g class="concept-node"><rect x="29" y="139" width="110" height="42" rx="8" /><text x="84" y="166" text-anchor="middle">Gateway</text></g>
      <g class="concept-node concept-failed"><rect x="204" y="66" width="108" height="42" rx="8" /><text x="258" y="93" text-anchor="middle">Service</text></g>
      <g class="concept-failure"><circle cx="305" cy="65" r="11" /><path d="m301 61 8 8m0-8-8 8" /></g>
      <text class="concept-small" x="258" y="132" text-anchor="middle">Unavailable</text>
      <g class="concept-node concept-active"><rect x="204" y="209" width="108" height="42" rx="8" /><text x="258" y="236" text-anchor="middle">Replica</text></g>
      <g class="concept-node"><rect x="370" y="139" width="120" height="42" rx="8" /><text x="430" y="166" text-anchor="middle">Database</text></g>
      <path class="concept-drop" d="M195 200h126v60H195Z" />
      <path class="concept-cursor" d="m316 252 1 32 9-8 7 12 6-3-7-12 12-3Z" />
      <circle class="concept-route-point" cx="340" cy="190" r="4" />
    </>}
    {variant === "factions" && <>
      <path class="concept-link" d="m155 116 65 42m145-42-65 42M260 203v-31" />
      <circle class="concept-arena" cx="260" cy="161" r="32" />
      <text x="260" y="167" text-anchor="middle">vs</text>
      {parties.map(({x,y,label,active}) => <g class:list={["concept-party", {"concept-active":active}]}>
        <rect class="concept-party-boundary" x={x-83} y={y-34} width="166" height="68" rx="34" />
        {[-46,0,46].map(offset => <g>
          <circle class="mode-player-ring" cx={x+offset} cy={y} r="18" />
          <circle class="mode-person" cx={x+offset} cy={y-5} r="4" />
          <path class="mode-person" d={`M${x+offset-8} ${y+8}c0-10 16-10 16 0`} />
        </g>)}
        <text x={x} y={y+(y>200?59:-49)} text-anchor="middle">{label}</text>
      </g>)}
    </>}
    {variant === "codebase-clash" && <>
      <g class="concept-repository">
        <path d="M38 66V45h47l12 13h89v26H38Z" />
        <text x="43" y="113">Existing repo</text>
        <path class="concept-link" d="M52 132v116m0-94h23m-23 48h23m-23 46h23" />
        <text class="concept-code" x="84" y="159">src/</text>
        <text class="concept-code" x="84" y="207">service</text>
        <text class="concept-code" x="84" y="253">tests/</text>
      </g>
      <path class="concept-link" d="M160 202h33a16 16 0 0 0 16-16V75h29" />
      <g class="concept-node"><rect x="238" y="51" width="244" height="46" rx="8" /><circle cx="260" cy="74" r="5" /><text x="278" y="80">Fix failing test</text></g>
      <path class="concept-route" d="M360 97v28" />
      <g class="concept-diff">
        <rect x="238" y="125" width="244" height="148" rx="8" />
        <path class="concept-link" d="M238 164h244" />
        <text class="concept-code" x="254" y="150">service</text>
        <path class="concept-code-line" d="M278 185h78m-66 18h96m-96 18h74m-86 18h116" />
        <path class="concept-removed" d="M254 202h10m14 0h137" />
        <path class="concept-added" d="M254 221h10m-5-5v10m19-5h151" />
      </g>
    </>}
    {variant === "odyssey" && <>
      <path class="concept-link" d="M130 230h20V161h15m100 0h15V67h75" />
      <g class="concept-node"><rect x="24" y="209" width="106" height="42" rx="8" /><text x="77" y="236" text-anchor="middle">Order</text></g>
      <g class="concept-node"><rect x="165" y="140" width="100" height="42" rx="8" /><text x="215" y="167" text-anchor="middle">Order</text><rect x="165" y="209" width="100" height="42" rx="8" /><text x="215" y="236" text-anchor="middle">Payment</text></g>
      <path class="concept-link" d="M215 182v27" />
      <g class="concept-node concept-active"><rect x="355" y="46" width="106" height="42" rx="8" /><text x="408" y="73" text-anchor="middle">Order</text></g>
      <path class="concept-route" d="M408 88v28m-66 25v-13a12 12 0 0 1 12-12h94a12 12 0 0 1 12 12v13" />
      <g class="concept-node"><rect x="290" y="141" width="104" height="42" rx="8" /><text x="342" y="168" text-anchor="middle">Payment</text><rect x="408" y="141" width="104" height="42" rx="8" /><text x="460" y="168" text-anchor="middle">Shipment</text></g>
      <text class="concept-small" x="77" y="272" text-anchor="middle">New</text>
      <text class="concept-small" x="215" y="272" text-anchor="middle">New → Paid</text>
      <text class="concept-small" x="408" y="272" text-anchor="middle">New → Paid → Sent</text>
      <text class="concept-round" x="77" y="303" text-anchor="middle">Round 1</text>
      <text class="concept-round" x="215" y="303" text-anchor="middle">Round 2</text>
      <text class="concept-round" x="408" y="303" text-anchor="middle">Round 3</text>
    </>}
  </svg>
</figure>
