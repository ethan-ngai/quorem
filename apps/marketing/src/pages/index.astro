---
import "@fontsource-variable/geist";
import "@quorem/ui/theme.css";
import "../styles/marketing.css";
import ProductPreview from "../components/ProductPreview.astro";
import MatchScene from "../components/MatchScene.astro";
import HeroDots from "../components/HeroDots.astro";
import BattleHeadline from "../components/BattleHeadline.astro";
import UpcomingModeIllustration from "../components/UpcomingModeIllustration.astro";
import MatchModeIllustration from "../components/MatchModeIllustration.astro";
import EditorPreview from "../components/EditorPreview";
import "@fontsource/jetbrains-mono/400.css";
const socialImage = Astro.site ? new URL("/social-card.png", Astro.site).href : "/social-card.png";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Challenge friends in private coding matches. Choose Showdown or Free-for-all, pick a problem, set the rules and share an invitation." />
    <meta name="theme-color" content="#f5f5f6" />
    <link rel="icon" data-favicon="ico" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" data-favicon="png" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" data-favicon="svg" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <script src="/favicon-theme.js" defer is:inline></script>
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Quorem" />
    <meta name="apple-mobile-web-app-title" content="Quorem" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quorem" />
    <meta property="og:title" content="Quorem — Private coding matches" />
    <meta property="og:description" content="Challenge friends in private coding matches. Choose a problem, set the rules and share an invitation." />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Quorem pixel logo — private coding matches and practice." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Quorem pixel logo — private coding matches and practice." />
    <title>Quorem — Private coding matches</title>
    <script is:inline>
      (() => {
        let preference = "system";
        try { preference = JSON.parse(localStorage.getItem("quorem.theme.v1") || '"system"'); } catch {}
        document.documentElement.dataset.theme = preference === "dark" || (preference !== "light" && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-width" data-reveal>
      <div class="brand-navigation">
      <details class="site-menu"><summary aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></summary><nav aria-label="Mobile navigation"><a href="/practice">Practice</a><a href="/practice?create=match">Create match</a></nav></details>
      <a class="brand-logo" href="/" aria-label="Quorem home"><span class="brand-mark" aria-hidden="true"></span></a>
      </div>
      <div class="header-actions">
      <nav class="desktop-navigation" aria-label="Main navigation">
        <a class="quiet-link" href="/practice">Practice</a>
        <a class="quiet-link" href="/practice?create=match">Create match</a>
      </nav>
      <button class="button nav-button login-button" type="button" disabled title="Login will be available when authentication is ready">Login</button>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <HeroDots />
        <div class="hero-top page-width">
          <div class="hero-copy">
          <BattleHeadline />
          <div class="hero-intro">
            <p>Invite friends to solve the same coding problem. First correct submission wins.</p>
            <div class="hero-actions"><a class="button primary-button hero-cta" href="/practice?create=match">Create match <span aria-hidden="true">↗</span></a></div>
          </div>
          </div>
          <MatchScene />
        </div>
      </section>
      <section class="mode-showcase page-width" aria-label="Match modes" data-reveal>
        <article class="mode-preview">
          <MatchModeIllustration variant="duel" />
          <div class="mode-description"><h2>Showdown <span>1 v 1</span></h2><p>Invite a friend. Solve the same problem.<br />First correct submission wins.</p></div>
        </article>
        <article class="mode-preview">
          <MatchModeIllustration variant="group" />
          <div class="mode-description"><h2>Free-for-all <span>2–8 players</span></h2><p>Share a challenge with the group.<br />Everyone writes their own solution.</p></div>
        </article>
        <article class="mode-preview">
          <UpcomingModeIllustration variant="tech-stacked" />
          <div class="mode-description"><h2>Tech Stacked <span class="coming-soon">Coming soon</span></h2><p>Design resilient enterprise systems. Drag blocks, connect nodes, and adapt as situations change.</p></div>
        </article>
        <article class="mode-preview">
          <UpcomingModeIllustration variant="factions" />
          <div class="mode-description"><h2>Factions <span class="coming-soon">Coming soon</span></h2><p>Bring your party into a match against other parties.</p></div>
        </article>
        <article class="mode-preview">
          <UpcomingModeIllustration variant="codebase-clash" />
          <div class="mode-description"><h2>Codebase Clash <span class="coming-soon">Coming soon</span></h2><p>Work in an existing repository. Track down a bug or build a new feature.</p></div>
        </article>
        <article class="mode-preview">
          <UpcomingModeIllustration variant="odyssey" />
          <div class="mode-description"><h2>Odyssey <span class="coming-soon">Coming soon</span></h2><p>Build an object-oriented system across multiple rounds. Extend your design as its states and requirements grow.</p></div>
        </article>
      </section>
      <section class="feature-section page-width" id="matches" aria-labelledby="matches-title">
        <div class="feature-heading" data-reveal><h2 id="matches-title">From invitation<br />to first submission.</h2><p>Choose a problem, set the time,<br />and send the link.</p></div>
        <div class="feature-grid">
          <article class="feature-panel lobby-panel" data-reveal>
            <div class="feature-copy"><h3>Set the match rules.</h3><p>Pick the challenge and decide how copy/paste and leaving the window are handled.</p></div>
            <div class="lobby-stage"><ProductPreview alt="Example Free-for-all lobby showing the shared problem, duration, players and host rules." /></div>
          </article>
          <article class="feature-panel challenge-panel" data-reveal>
            <div class="feature-copy"><h3>Pick a problem.<br />Or leave it to chance.</h3><p>Choose a difficulty. Random problems stay hidden until the match starts.</p></div>
            <div class="challenge-stack" aria-hidden="true"><div class="challenge-card card-back"><span>Hard</span><strong>Split Load</strong></div><div class="challenge-card card-middle"><span>Medium</span><strong>Level Spreads</strong></div><div class="challenge-card card-front"><span>Easy</span><strong>Run Widths</strong><div class="challenge-code"><i>[</i> 2, 2, 3, 3, 3, 1 <i>]</i></div><div class="challenge-answer">[ 2, 3, 1 ] <span>✓</span></div></div></div>
            <a class="quiet-link" href="/practice">Browse problems <span aria-hidden="true">→</span></a>
          </article>
          <article class="feature-panel editor-panel" data-reveal>
            <div class="feature-copy"><h3>Write and test your solution.</h3><p>Write your solution, try your own cases, then submit when you’re ready.</p></div>
            <div class="editor-stage"><EditorPreview client:visible /><noscript><p>Open practice to try the editor.</p></noscript></div>
          </article>
          <article class="feature-panel verdict-panel" data-reveal>
            <div class="verdict-art" aria-hidden="true"><div class="verdict-lines">{Array.from({length: 12}, (_, i) => <span style={`--line: ${i}`} />)}</div><div class="verdict-stamp"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg></div></div>
            <div class="feature-copy"><h3>Submissions decide the winner.</h3><p>Submissions decide the match. Test runs are yours to experiment with.</p></div>
          </article>
        </div>
      </section>
      <section class="closing page-width" aria-labelledby="closing-title" data-reveal><h2 id="closing-title">Invite your friends.<br />Pick a problem.</h2><div class="closing-actions"><a class="button primary-button" href="/practice?create=match">Create match <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/practice">Browse practice <span aria-hidden="true">→</span></a></div></section>
    </main>
    <footer class="site-footer page-width" data-reveal><a class="brand-logo" href="/" aria-label="Quorem home"><span class="brand-mark" aria-hidden="true"></span></a><span>Private coding matches and practice.</span><a class="quiet-link" href="/practice">Browse problems <span aria-hidden="true">→</span></a>
      <button class="theme-switch" type="button" aria-label="Switch to dark theme" title="Switch theme">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" /></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14a8 8 0 0 1-10-10 8 8 0 1 0 10 10Z" /></svg>
      </button>
    </footer>
    <script>
      document.querySelectorAll(".site-menu a").forEach((link) => link.addEventListener("click", () => {
        const menu = document.querySelector<HTMLDetailsElement>(".site-menu");
        if (menu) menu.open = false;
      }));
      const closeMenus = () => document.querySelectorAll<HTMLDetailsElement>(".site-menu").forEach((menu) => { menu.open = false; });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const openMenu = document.querySelector<HTMLDetailsElement>(".site-menu[open]");
          openMenu?.querySelector<HTMLElement>("summary")?.focus();
          closeMenus();
        }
      });
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && !target.closest(".site-menu")) closeMenus();
      });
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      const toggle = document.querySelector<HTMLButtonElement>(".theme-switch");
      const updateLabel = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        toggle?.setAttribute("aria-label", `Switch to ${next} theme`);
        toggle?.setAttribute("title", `Switch to ${next} theme`);
      };
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("quorem.theme.v1", JSON.stringify(next)); } catch {}
        updateLabel();
      });
      media.addEventListener("change", () => {
        let preference = "system";
        try { preference = JSON.parse(localStorage.getItem("quorem.theme.v1") || '"system"'); } catch {}
        if (preference === "system") document.documentElement.dataset.theme = media.matches ? "dark" : "light";
        updateLabel();
      });
      updateLabel();
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => {
          if (element.getBoundingClientRect().top > window.innerHeight) element.classList.add("reveal-pending");
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
