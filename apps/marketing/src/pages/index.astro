---
import "@fontsource-variable/geist";
import "@quorem/ui/theme.css";
import "../styles/marketing.css";
import "../../../web/src/features/matches/competitive.css";
import workspaceStyles from "../../../web/src/styles/workspace.css?inline";
import LobbyPreview from "../components/LobbyPreview";
import SubmissionPreview from "../components/SubmissionPreview";
import ProblemCards from "../components/ProblemCards.astro";
import HeroDots from "../components/HeroDots.astro";
import BattleHeadline from "../components/BattleHeadline.astro";
import UpcomingModeIllustration from "../components/UpcomingModeIllustration.astro";
import UpcomingFeaturePreview from "../components/UpcomingFeaturePreview.astro";
import MatchModeIllustration from "../components/MatchModeIllustration.astro";
import EditorPreview from "../components/EditorPreview";
import HeroEditorPreview from "../components/HeroEditorPreview";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import ClosingScene from "../components/ClosingScene.astro";
import "@fontsource/jetbrains-mono/400.css";
const socialImage = Astro.site
    ? new URL("/social-card.png", Astro.site).href
    : "/social-card.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="Challenge friends in private coding matches. Choose Showdown or Free-for-all, pick a problem, set the rules and share an invitation."
        />
        <meta name="theme-color" content="#f5f5f6" />
        <link
            rel="icon"
            data-favicon="ico"
            href="/favicon.ico?v=2"
            sizes="16x16 32x32 48x48 96x96"
        />
        <link
            rel="icon"
            data-favicon="png"
            type="image/png"
            href="/favicon-96x96.png?v=2"
            sizes="96x96"
        />
        <link
            rel="icon"
            data-favicon="svg"
            type="image/svg+xml"
            href="/favicon.svg"
            sizes="any"
        />
        <link
            rel="apple-touch-icon"
            href="/apple-touch-icon.png"
            sizes="180x180"
        />
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
        <script src="/favicon-theme.js?v=2" defer is:inline></script>
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="application-name" content="Quorem" />
        <meta name="apple-mobile-web-app-title" content="Quorem" />
        <meta name="msapplication-config" content="/browserconfig.xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Quorem" />
        <meta property="og:title" content="Quorem — Private coding matches" />
        <meta
            property="og:description"
            content="Challenge friends in private coding matches. Choose a problem, set the rules and share an invitation."
        />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Quorem pixel logo — private coding matches and practice."
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={socialImage} />
        <meta
            name="twitter:image:alt"
            content="Quorem pixel logo — private coding matches and practice."
        />
        <style
            is:inline
            set:html={`@scope (.workspace-demo) { ${workspaceStyles} }`}
        />
        <title>Quorem — Private coding matches</title>
        <script is:inline>
            (() => {
                let preference = "system";
                try {
                    preference = JSON.parse(
                        localStorage.getItem("quorem.theme.v1") || '"system"',
                    );
                } catch {}
                document.documentElement.dataset.theme =
                    preference === "dark" ||
                    (preference !== "light" &&
                        matchMedia("(prefers-color-scheme: dark)").matches)
                        ? "dark"
                        : "light";
            })();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <header class="site-header page-width" data-reveal>
            <div class="brand-navigation">
                <details class="site-menu">
                    <summary aria-label="Open navigation">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </summary>
                    <nav aria-label="Mobile navigation">
                        <a href="/practice">Practice</a>
                        <a href="/practice?create=match">Create match</a>
                    </nav>
                </details>
                <a class="brand-logo" href="/" aria-label="Quorem home">
                    <span class="brand-mark" aria-hidden="true"></span>
                </a>
            </div>
            <div class="header-actions">
                <nav class="desktop-navigation" aria-label="Main navigation">
                    <a class="quiet-link" href="/practice">
                        Practice
                    </a>
                    <a class="quiet-link" href="/practice?create=match">
                        Create match
                    </a>
                </nav>
                <button
                    class="button nav-button login-button"
                    type="button"
                    disabled
                    title="Login will be available when authentication is ready"
                >
                    Login
                </button>
                <ThemeSwitch />
            </div>
        </header>
        <main id="main">
            <section class="hero" aria-labelledby="hero-title">
                <HeroDots />
                <div class="hero-top page-width">
                    <div class="hero-copy">
                        <BattleHeadline />
                        <div class="hero-intro">
                            <p>
                                Invite friends to solve the same coding problem.
                                First correct submission wins.
                            </p>
                            <div class="hero-actions">
                                <a
                                    class="button primary-button hero-cta"
                                    href="/practice?create=match"
                                >
                                    Create match
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="hero-workspace">
                        <HeroEditorPreview client:visible />
                    </div>
                </div>
            </section>
            <section
                id="modes"
                class="mode-showcase page-width"
                aria-label="Match modes"
                data-reveal
            >
                <div class="mode-row">
                    <article class="mode-preview">
                        <MatchModeIllustration variant="duel" />
                        <div class="mode-description">
                            <h2>
                                Showdown <span>1 v 1</span>
                            </h2>
                            <p>
                                Invite a friend. Solve the same problem.
                                <br />
                                First correct submission wins.
                            </p>
                        </div>
                    </article>
                    <article class="mode-preview">
                        <MatchModeIllustration variant="group" />
                        <div class="mode-description">
                            <h2>
                                Free-for-all <span>2–8 players</span>
                            </h2>
                            <p>
                                Share a challenge with the group.
                                <br />
                                Everyone writes their own solution.
                            </p>
                        </div>
                    </article>
                </div>
                <div class="mode-row">
                    <article class="mode-preview">
                        <UpcomingModeIllustration variant="tech-stacked" />
                        <div class="mode-description">
                            <h2>
                                Tech Stacked{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h2>
                            <p>
                                Design resilient enterprise systems. Drag
                                blocks, connect nodes, and adapt as situations
                                change.
                            </p>
                        </div>
                    </article>
                    <article class="mode-preview">
                        <UpcomingModeIllustration variant="factions" />
                        <div class="mode-description">
                            <h2>
                                Factions{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h2>
                            <p>
                                Bring your party into a match against other
                                parties.
                            </p>
                        </div>
                    </article>
                </div>
                <div class="mode-row">
                    <article class="mode-preview">
                        <UpcomingModeIllustration variant="codebase-clash" />
                        <div class="mode-description">
                            <h2>
                                Codebase Clash{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h2>
                            <p>
                                Work in an existing repository. Track down a bug
                                or build a new feature.
                            </p>
                        </div>
                    </article>
                    <article class="mode-preview">
                        <UpcomingModeIllustration variant="odyssey" />
                        <div class="mode-description">
                            <h2>
                                Odyssey{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h2>
                            <p>
                                Build an object-oriented system across multiple
                                rounds. Extend your design as its states and
                                requirements grow.
                            </p>
                        </div>
                    </article>
                </div>
            </section>
            <section
                class="feature-section page-width"
                id="matches"
                aria-labelledby="matches-title"
            >
                <div class="feature-heading" data-reveal>
                    <h2 id="matches-title">
                        From invitation
                        <br />
                        to first submission.
                    </h2>
                    <p>
                        Choose a problem, set the time,
                        <br />
                        and send the link.
                    </p>
                </div>
                <div class="feature-grid walkthrough-grid">
                    <div class="walkthrough-layout">
                        <div class="walkthrough-column">
                            <article
                                class="feature-panel lobby-panel"
                                data-reveal
                            >
                                <div class="feature-copy">
                                    <h3>Create a lobby and ready up.</h3>
                                    <p>
                                        Change lobby settings, invite friends,
                                        and set rules.
                                    </p>
                                </div>
                                <div class="lobby-stage">
                                    <LobbyPreview />
                                </div>
                            </article>
                            <article
                                class="feature-panel verdict-panel"
                                data-reveal
                            >
                                <div class="feature-copy">
                                    <h3>Battle for correctness.</h3>
                                    <p>
                                        The first passing submission takes it
                                        all.
                                    </p>
                                </div>
                                <SubmissionPreview client:visible />
                            </article>
                        </div>
                        <div class="walkthrough-column">
                            <article
                                class="feature-panel challenge-panel"
                                data-reveal
                            >
                                <div class="feature-copy">
                                    <h3>
                                        Pick a problem.
                                        <br />
                                        Or leave it to chance.
                                    </h3>
                                    <p>
                                        Filter problem selection by difficulty
                                        and topics.
                                    </p>
                                </div>
                                <ProblemCards />
                                <a class="quiet-link" href="/practice">
                                    Browse problems{" "}
                                    <span aria-hidden="true">→</span>
                                </a>
                            </article>
                            <article
                                class="feature-panel editor-panel"
                                data-reveal
                            >
                                <div class="feature-copy">
                                    <h3>Write and test your solution.</h3>
                                    <p>
                                        Write your solution, try your own cases,
                                        then submit when you’re ready.
                                    </p>
                                </div>
                                <div class="editor-stage">
                                    <EditorPreview client:visible />
                                    <noscript>
                                        <p>Open practice to try the editor.</p>
                                    </noscript>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </section>
            <section
                id="upcoming"
                class="feature-section page-width"
                aria-labelledby="upcoming-title"
                data-reveal
            >
                <div class="feature-heading">
                    <h2 id="upcoming-title">Coming soon</h2>
                </div>
                <div class="feature-grid upcoming-feature-grid">
                    <article class="feature-panel social-panel">
                        <div class="feature-copy">
                            <h3>
                                Social{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h3>
                            <p>
                                See where you stand on leaderboards. Track your
                                nemeses and your wins and losses against each
                                other.
                            </p>
                        </div>
                        <UpcomingFeaturePreview variant="social" />
                    </article>
                    <article class="feature-panel adaptive-panel">
                        <div class="feature-copy">
                            <h3>
                                Adaptive{" "}
                                <span class="coming-soon">Coming soon</span>
                            </h3>
                            <p>
                                Get problem recommendations based on your past
                                performance, for competitive matches or solo
                                practice.
                            </p>
                        </div>
                        <UpcomingFeaturePreview variant="adaptive" />
                    </article>
                </div>
            </section>
            <section
                class="closing page-width"
                aria-labelledby="closing-title"
                data-reveal
            >
                <div class="closing-copy">
                    <h2 id="closing-title">
                        Start a match
                        <br />
                        with a friend.
                    </h2>
                    <div class="closing-actions">
                        <a
                            class="button primary-button"
                            href="/practice?create=match"
                        >
                            Create match
                        </a>
                        <a class="button secondary-button" href="/practice">
                            Practice solo
                        </a>
                    </div>
                </div>
                <ClosingScene />
            </section>
        </main>
        <footer class="site-footer page-width" data-reveal>
            <div class="footer-main">
                <a class="footer-brand" href="/" aria-label="Quorem home">
                    <span class="brand-mark" aria-hidden="true"></span>
                </a>
                <nav class="footer-sitemap" aria-label="Sitemap">
                    <div>
                        <strong>Play</strong>
                        <a href="/practice?create=match">Create match</a>
                        <a href="/practice">Practice</a>
                    </div>
                    <div>
                        <strong>Explore</strong>
                        <a href="#modes">Game modes</a>
                        <a href="#matches">How it works</a>
                        <a href="#upcoming">Coming soon</a>
                    </div>
                </nav>
            </div>
            <div class="footer-bottom">
                <p>
                    © {new Date().getFullYear()} Quorem.{" "}
                    <span>All rights reserved.</span>
                </p>
                <div class="footer-appearance">
                    <ThemeSwitch />
                </div>
            </div>
        </footer>
        <script>
            document.querySelectorAll(".site-menu a").forEach((link) =>
                link.addEventListener("click", () => {
                    const menu =
                        document.querySelector<HTMLDetailsElement>(
                            ".site-menu",
                        );
                    if (menu) menu.open = false;
                }),
            );
            const closeMenus = () =>
                document
                    .querySelectorAll<HTMLDetailsElement>(".site-menu")
                    .forEach((menu) => {
                        menu.open = false;
                    });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    const openMenu =
                        document.querySelector<HTMLDetailsElement>(
                            ".site-menu[open]",
                        );
                    openMenu?.querySelector<HTMLElement>("summary")?.focus();
                    closeMenus();
                }
            });
            document.addEventListener("click", (event) => {
                const target = event.target;
                if (target instanceof Element && !target.closest(".site-menu"))
                    closeMenus();
            });
            const media = window.matchMedia("(prefers-color-scheme: dark)");
            const toggles =
                document.querySelectorAll<HTMLButtonElement>(".theme-switch");
            const updateLabel = () => {
                const next =
                    document.documentElement.dataset.theme === "dark"
                        ? "light"
                        : "dark";
                toggles.forEach((toggle) => {
                    toggle.setAttribute(
                        "aria-label",
                        `Switch to ${next} theme`,
                    );
                    toggle.setAttribute("title", `Switch to ${next} theme`);
                });
            };
            toggles.forEach((toggle) =>
                toggle.addEventListener("click", () => {
                    const next =
                        document.documentElement.dataset.theme === "dark"
                            ? "light"
                            : "dark";
                    document.documentElement.dataset.theme = next;
                    try {
                        localStorage.setItem(
                            "quorem.theme.v1",
                            JSON.stringify(next),
                        );
                    } catch {}
                    updateLabel();
                }),
            );
            media.addEventListener("change", () => {
                let preference = "system";
                try {
                    preference = JSON.parse(
                        localStorage.getItem("quorem.theme.v1") || '"system"',
                    );
                } catch {}
                if (preference === "system")
                    document.documentElement.dataset.theme = media.matches
                        ? "dark"
                        : "light";
                updateLabel();
            });
            updateLabel();
            if (
                !window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ) {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.08 },
                );
                document
                    .querySelectorAll<HTMLElement>("[data-reveal]")
                    .forEach((element) => {
                        if (
                            element.getBoundingClientRect().top >
                            window.innerHeight
                        )
                            element.classList.add("reveal-pending");
                        observer.observe(element);
                    });
            }
        </script>
    </body>
</html>
