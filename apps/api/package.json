{
  "name": "@quorem/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp exec vitest run --config vitest.config.ts",
    "test:workers": "vp exec vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:boundaries": "node --experimental-strip-types src/check-boundaries.ts",
    "start": "node --experimental-strip-types src/runtime/node.ts",
    "test:identity": "vp exec vitest run --config src/adapters/identity/vitest.config.ts",
    "test:identity:workers": "vp exec vitest run --config src/adapters/identity/vitest.workers.config.ts",
    "test:identity:node": "node src/adapters/identity/strip-smoke.ts",
    "test:catalog": "vp exec vitest run --config src/adapters/postgres/problems/queries/vitest.config.ts",
    "test:catalog:workers": "vp exec vitest run --config src/adapters/postgres/problems/queries/vitest.workers.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1150.0",
    "@codemirror/state": "^6.5.2",
    "@hono/node-server": "2.1.5",
    "@quorem/database": "workspace:*",
    "@quorem/execution": "workspace:*",
    "@quorem/questions": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jose": "6.2.12",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.156.0"
  }
}
