{
  "name": "@quorem/database",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema/index.ts",
    "./migrations": "./src/migrations.ts",
    "./auth-adapter-schema": "./src/schema/auth/adapter.ts",
    "./core": "./src/core/index.ts"
