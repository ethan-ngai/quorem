{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quorem question v1",
  "$ref": "#/$defs/QuestionContent",
  "$defs": {
    "QuestionContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem": {
          "$ref": "#/$defs/AuthoredQuestionProblem"
        },
        "hiddenCases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CustomCase"
          }
        },
        "attribution": {
          "type": "string"
        },
        "canonicalApproachId": {
          "type": "string",
          "maxLength": 64
        },
        "approaches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/SolutionApproach"
          }
        }
      },
      "required": [
        "problem",
        "hiddenCases",
        "attribution",
        "canonicalApproachId",
        "approaches"
      ]
    },
    "AuthoredQuestionProblem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "leetcodeId": {
          "type": "integer",
          "minimum": 1,
          "nullable": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statementMarkdown": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemExample"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        },
        "limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "sql": {
          "$ref": "#/$defs/SqlConfig"
        },
        "odyssey": {
          "$ref": "#/$defs/AuthoredOdyssey"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "difficulty",
        "tags",
        "statementMarkdown",
        "examples",
        "constraints",
        "limits"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "sql"
                ],
                "properties": {
                  "sql": {}
                }
              },
              {
                "required": [
                  "odyssey"
                ],
                "properties": {
                  "odyssey": {}
                }
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "signature"
              ],
              "properties": {
                "signature": {}
              }
            }
          },
          "else": {
            "required": [
              "signature"
            ],
            "properties": {
              "signature": {}
            }
          }
        }
      ]
    },
    "Difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "ProblemExample": {
      "type": "object",
      "properties": {
        "graphs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/QuestionGraph"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        },
        "explanation": {
          "type": "string"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodCall"
          }
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "QuestionGraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directed": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/GraphNodeId"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/GraphNodeId"
                  },
                  "value": {
                    "$ref": "#/$defs/WireValue"
                  }
                },
                "required": [
                  "id",
                  "value"
                ]
              }
            ]
          },
          "maxItems": 100000
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "#/$defs/GraphNodeId"
              },
              "to": {
                "$ref": "#/$defs/GraphNodeId"
              },
              "value": {
                "$ref": "#/$defs/WireValue"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "maxItems": 100000
        }
      },
      "required": [
        "directed",
        "nodes",
        "edges"
      ]
    },
    "GraphNodeId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      ]
    },
    "WireValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/WireValue"
          }
        }
      ]
    },
    "MethodCall": {
      "type": "object",
      "properties": {
        "methodName": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": [
        "methodName",
        "args"
      ],
      "additionalProperties": false
    },
    "Constraint": {
      "oneOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "target": {
                  "$ref": "#/$defs/ConstraintTarget"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minInclusive": {
                  "type": "boolean",
                  "description": "Include the lower bound. Omitted is inclusive; false is strict."
                },
                "maxInclusive": {
                  "type": "boolean",
                  "description": "Include the upper bound. Omitted is inclusive; false is strict."
                },
                "quantifier": {
                  "type": "string",
                  "enum": [
                    "all",
                    "any"
                  ],
                  "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
                }
              },
              "dependentRequired": {
                "minInclusive": [
                  "min"
                ],
                "maxInclusive": [
                  "max"
                ]
              },
              "required": [
                "kind",
                "target",
                "min"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "target": {
                  "$ref": "#/$defs/ConstraintTarget"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minInclusive": {
                  "type": "boolean",
                  "description": "Include the lower bound. Omitted is inclusive; false is strict."
                },
                "maxInclusive": {
                  "type": "boolean",
                  "description": "Include the upper bound. Omitted is inclusive; false is strict."
                },
                "quantifier": {
                  "type": "string",
                  "enum": [
                    "all",
                    "any"
                  ],
                  "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
                }
              },
              "dependentRequired": {
                "minInclusive": [
                  "min"
                ],
                "maxInclusive": [
                  "max"
                ]
              },
              "required": [
                "kind",
                "target",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "comparison"
            },
            "left": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "right": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "operator": {
              "type": "string",
              "enum": [
                "eq",
                "le",
                "lt",
                "ge",
                "gt"
              ]
            },
            "quantifier": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ],
              "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
            }
          },
          "required": [
            "kind",
            "left",
            "right",
            "operator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "property"
            },
            "target": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "property": {
              "type": "string",
              "enum": [
                "sorted",
                "nondecreasing",
                "unique"
              ]
            },
            "direction": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "Ordering direction. Omitted is asc. Applies only to sorted/nondecreasing properties."
            }
          },
          "required": [
            "kind",
            "target",
            "property"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prose"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ConstraintTarget": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "enum": [
            "value",
            "length",
            "elements",
            "sum",
            "nodeCount",
            "nodeValues"
          ]
        }
      },
      "required": [
        "parameter",
        "projection"
      ],
      "additionalProperties": false
    },
    "Signature": {
      "type": "object",
      "properties": {
        "graphEncodings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/GraphEncoding"
          }
        },
        "className": {
          "type": "string",
          "enum": [
            "Solution"
          ]
        },
        "methodName": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "returnType": {
          "type": "string"
        },
        "nodeReferences": {
          "type": "string",
          "enum": [
            "arguments",
            "return"
          ],
          "description": "Enable call-local node references. Return mode also compares the returned node by identity."
        },
        "outputOrder": {
          "type": "string",
          "enum": [
            "ordered",
            "unordered"
          ],
          "description": "Outer list comparison order. Omitted is ordered; nested lists and duplicates remain significant."
        },
        "description": {
          "type": "string"
        },
        "returns": {
          "type": "string"
        },
        "throws": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "className",
        "methodName",
        "parameters",
        "returnType"
      ],
      "additionalProperties": false
    },
    "GraphEncoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "edgeList",
            "adjacencyList",
            "adjacencyMatrix",
            "successor",
            "parent",
            "custom"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "nodeValueType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "edgeValueType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "countParameter": {
          "type": "string",
          "minLength": 1
        },
        "firstNode": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "edgeValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "matrixDiagonal": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputPresetConfig"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "InputPresetConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1,
          "description": "Registered input preset ID. Built-ins: default, number, text, boolean, sequence, matrix, tree, linkedList, structured. Server rejects unregistered or codec-incompatible presets."
        },
        "placeholder": {
          "type": "string",
          "maxLength": 512
        },
        "layout": {
          "type": "string",
          "enum": [
            "inline",
            "rows"
          ],
          "description": "Display a two-dimensional array on one line or one row per line. Defaults to inline."
        },
        "showGrid": {
          "type": "boolean",
          "description": "Show a grid from this two-dimensional array in examples and tests."
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "ExecutionLimits": {
      "type": "object",
      "properties": {
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 1
        },
        "maxCollectionElements": {
          "type": "integer",
          "minimum": 1
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "wallTimeMs",
        "memoryBytes",
        "outputBytes",
        "maxProcesses",
        "maxCollectionElements",
        "maxNestingDepth"
      ],
      "additionalProperties": false
    },
    "SqlConfig": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "postgresql"
          ]
        },
        "outputOrder": {
          "type": "string",
          "enum": [
            "ordered",
            "unordered"
          ]
        },
        "tables": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/SqlTableSchema"
          }
        },
        "output": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/SqlColumn"
          }
        }
      },
      "required": [
        "dialect",
        "outputOrder"
      ],
      "additionalProperties": false
    },
    "SqlTableSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/SqlColumn"
          }
        }
      },
      "required": [
        "name",
        "columns"
      ]
    },
    "SqlColumn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "integer",
            "bigint",
            "numeric",
            "text",
            "boolean",
            "date",
            "timestamp",
            "timestamptz",
            "real",
            "double precision"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "AuthoredOdyssey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/AuthoredOdysseyLevel"
          }
        }
      },
      "required": [
        "levels"
      ]
    },
    "AuthoredOdysseyLevel": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "statementMarkdown": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signature"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemExample"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "hiddenCases": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/CustomCase"
          }
        }
      },
      "required": [
        "title",
        "statementMarkdown",
        "methods",
        "examples",
        "hiddenCases"
      ],
      "additionalProperties": false
    },
    "CustomCase": {
      "type": "object",
      "properties": {
        "graphs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/QuestionGraph"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodCall"
          }
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "SolutionApproach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "explanationMarkdown",
        "timeComplexity",
        "spaceComplexity",
        "complexityNotes",
        "implementations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional for the canonical approach; other approaches require a name."
        },
        "defaultLanguage": {
          "type": "string",
          "enum": [
            "python",
            "java",
            "typescript",
            "ocaml",
            "postgresql"
          ]
        },
        "explanationMarkdown": {
          "type": "string"
        },
        "timeComplexity": {
          "type": "string"
        },
        "spaceComplexity": {
          "type": "string"
        },
        "complexityNotes": {
          "type": "string"
        },
        "implementations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/SolutionCode"
          }
        }
      }
    },
    "SolutionCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "source"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "python",
            "java",
            "typescript",
            "ocaml",
            "postgresql"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
