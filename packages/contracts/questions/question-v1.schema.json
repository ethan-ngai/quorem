{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quorem question v1",
  "$ref": "#/$defs/QuestionContent",
  "$defs": {
    "QuestionContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem": {
          "$ref": "#/$defs/AuthoredQuestionProblem"
        },
        "hiddenCases": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CustomCase"
          }
        },
        "attribution": {
          "type": "string"
        },
        "canonicalApproachId": {
          "type": "string",
          "maxLength": 64
        },
        "approaches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/SolutionApproach"
          }
        }
      },
      "required": [
        "problem",
        "hiddenCases",
        "attribution",
        "canonicalApproachId",
        "approaches"
      ]
    },
    "AuthoredQuestionProblem": {
      "type": "object",
      "properties": {
        "caseBudget": {
          "$ref": "#/$defs/CaseBudget"
        },
        "acceptance": {
          "$ref": "#/$defs/QuestionAcceptance"
        },
        "slug": {
          "type": "string",
          "pattern": "^(?=(?:private-[0-9a-f]{16}-)?[a-z0-9-]{1,80}$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "leetcodeId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statementMarkdown": {
          "type": "string",
          "description": "Problem Markdown. Use $...$ for formulas, Big O, numbers, arithmetic, comparisons, and mathematical variables such as n. Use backticks for code identifiers, indexing, and property access such as nums[i] and nums.length, even inside a formula. Example: $1 \\le$ `nums[i]` $\\le 50$. Use language-tagged fenced blocks for multiline code or pseudocode and $$ on separate lines for display math."
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemExample"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        },
        "limits": {
          "$ref": "#/$defs/ExecutionLimits",
          "description": "Omit to use the default execution limits."
        },
        "sql": {
          "$ref": "#/$defs/SqlConfig"
        },
        "odyssey": {
          "$ref": "#/$defs/AuthoredOdyssey"
        }
      },
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "difficulty",
        "tags",
        "statementMarkdown",
        "examples",
        "constraints"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "sql"
                ],
                "properties": {
                  "sql": {}
                }
              },
              {
                "required": [
                  "odyssey"
                ],
                "properties": {
                  "odyssey": {}
                }
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "signature"
              ],
              "properties": {
                "signature": {}
              }
            }
          },
          "else": {
            "required": [
              "signature"
            ],
            "properties": {
              "signature": {}
            }
          }
        }
      ]
    },
    "CaseBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "space"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/CaseGrowth"
        },
        "space": {
          "$ref": "#/$defs/CaseGrowth"
        }
      }
    },
    "CaseGrowth": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argument",
            "measure",
            "growth"
          ],
          "properties": {
            "argument": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "measure": {
              "type": "string",
              "enum": [
                "length",
                "value"
              ]
            },
            "growth": {
              "type": "string",
              "enum": [
                "linear",
                "logarithmic",
                "linearithmic",
                "quadratic"
              ]
            }
          }
        }
      }
    },
    "QuestionAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "efficient"
      ],
      "properties": {
        "small": {
          "$ref": "#/$defs/AcceptanceProfile"
        },
        "efficient": {
          "$ref": "#/$defs/AcceptanceProfile"
        }
      }
    },
    "AcceptanceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseCount",
        "complexity"
      ],
      "properties": {
        "caseCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "complexity": {
          "$ref": "#/$defs/ComplexityBound"
        }
      }
    },
    "ComplexityBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeComplexity",
        "spaceComplexity"
      ],
      "properties": {
        "timeComplexity": {
          "type": "string"
        },
        "spaceComplexity": {
          "type": "string"
        }
      }
    },
    "Difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "ProblemExample": {
      "type": "object",
      "properties": {
        "graphs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/QuestionGraph"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        },
        "explanation": {
          "type": "string",
          "description": "Example Markdown. Use $...$ for math and backticks for code, array access, and property access. Put example-specific diagrams and fenced code here."
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodCall"
          }
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "QuestionGraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directed": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/GraphNodeId"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/GraphNodeId"
                  },
                  "value": {
                    "$ref": "#/$defs/WireValue"
                  }
                },
                "required": [
                  "id",
                  "value"
                ]
              }
            ]
          },
          "maxItems": 100000
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "#/$defs/GraphNodeId"
              },
              "to": {
                "$ref": "#/$defs/GraphNodeId"
              },
              "value": {
                "$ref": "#/$defs/WireValue"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "maxItems": 100000
        }
      },
      "required": [
        "directed",
        "nodes",
        "edges"
      ]
    },
    "GraphNodeId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      ]
    },
    "WireValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/WireValue"
          }
        }
      ]
    },
    "MethodCall": {
      "type": "object",
      "properties": {
        "methodName": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        }
      },
      "required": [
        "methodName",
        "args"
      ],
      "additionalProperties": false
    },
    "Constraint": {
      "oneOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "target": {
                  "$ref": "#/$defs/ConstraintTarget"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minInclusive": {
                  "type": "boolean",
                  "description": "Include the lower bound. Omitted is inclusive; false is strict."
                },
                "maxInclusive": {
                  "type": "boolean",
                  "description": "Include the upper bound. Omitted is inclusive; false is strict."
                },
                "quantifier": {
                  "type": "string",
                  "enum": [
                    "all",
                    "any"
                  ],
                  "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
                }
              },
              "dependentRequired": {
                "minInclusive": [
                  "min"
                ],
                "maxInclusive": [
                  "max"
                ]
              },
              "required": [
                "kind",
                "target",
                "min"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "range"
                },
                "target": {
                  "$ref": "#/$defs/ConstraintTarget"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "minInclusive": {
                  "type": "boolean",
                  "description": "Include the lower bound. Omitted is inclusive; false is strict."
                },
                "maxInclusive": {
                  "type": "boolean",
                  "description": "Include the upper bound. Omitted is inclusive; false is strict."
                },
                "quantifier": {
                  "type": "string",
                  "enum": [
                    "all",
                    "any"
                  ],
                  "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
                }
              },
              "dependentRequired": {
                "minInclusive": [
                  "min"
                ],
                "maxInclusive": [
                  "max"
                ]
              },
              "required": [
                "kind",
                "target",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "comparison"
            },
            "left": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "right": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "operator": {
              "type": "string",
              "enum": [
                "eq",
                "le",
                "lt",
                "ge",
                "gt",
                "ne"
              ]
            },
            "quantifier": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ],
              "description": "all (default): every projected value/pair satisfies the rule; any: at least one does. Empty projections satisfy all and fail any."
            },
            "pairing": {
              "type": "string",
              "enum": [
                "corresponding"
              ],
              "description": "Compare matching positions and require equal projection sizes. Omitted compares all combinations."
            }
          },
          "required": [
            "kind",
            "left",
            "right",
            "operator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "property"
            },
            "target": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "property": {
              "type": "string",
              "enum": [
                "sorted",
                "nondecreasing",
                "unique",
                "strictlySorted",
                "adjacentDistinct",
                "even",
                "powerOfTwo",
                "symmetric",
                "tree",
                "binaryTree",
                "star",
                "acyclic",
                "noLoops",
                "noParallelEdges"
              ]
            },
            "direction": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "Ordering direction. Omitted is asc. Applies only to ordering properties."
            }
          },
          "required": [
            "kind",
            "target",
            "property"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "membership"
            },
            "target": {
              "$ref": "#/$defs/ConstraintTarget"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "maxLength": 256
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "negated": {
              "type": "boolean",
              "description": "When true, exclude every listed value. Omitted allows only listed values."
            }
          },
          "required": [
            "kind",
            "target",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "definition"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$",
              "description": "A name used in the statement for a derived input measurement."
            },
            "target": {
              "$ref": "#/$defs/ConstraintTarget"
            }
          },
          "required": [
            "kind",
            "name",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "prose"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Use only for rules without a structured equivalent. Use Markdown with LaTeX for math and backticks for program accesses."
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ConstraintTarget": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "enum": [
            "value",
            "length",
            "elements",
            "sum",
            "nodeCount",
            "nodeValues",
            "characters",
            "indices",
            "diagonal",
            "columns",
            "graph"
          ]
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "each"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 99999
              }
            ]
          },
          "description": "Walk into each element or a zero-based index before measuring. For example, [\"each\"] with length measures each row; [\"each\", 0] with value selects the first column."
        },
        "offset": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Add this integer to each numeric measurement, for bounds such as n - 1."
        },
        "total": {
          "type": "boolean",
          "description": "Sum all projected numeric measurements into one number, such as the total length of all rows."
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "Apply numeric operations in order after measuring, totaling, and adding the offset. Sequences combine at matching positions; scalars broadcast.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "operand"
            ],
            "properties": {
              "operator": {
                "type": "string",
                "enum": [
                  "add",
                  "subtract",
                  "multiply"
                ]
              },
              "operand": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "$ref": "#/$defs/ConstraintTarget"
                  }
                ]
              }
            }
          }
        }
      },
      "required": [
        "parameter",
        "projection"
      ],
      "additionalProperties": false
    },
    "Signature": {
      "type": "object",
      "properties": {
        "graphEncodings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/GraphEncoding"
          }
        },
        "className": {
          "type": "string",
          "enum": [
            "Solution"
          ]
        },
        "methodName": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "returnType": {
          "type": "string"
        },
        "nodeReferences": {
          "type": "string",
          "enum": [
            "arguments",
            "return"
          ],
          "description": "Enable call-local node references. Return mode also compares the returned node by identity."
        },
        "outputOrder": {
          "type": "string",
          "enum": [
            "ordered",
            "unordered"
          ],
          "description": "Outer list comparison order. Omitted is ordered; nested lists and duplicates remain significant."
        },
        "description": {
          "type": "string"
        },
        "returns": {
          "type": "string"
        },
        "throws": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "className",
        "methodName",
        "parameters",
        "returnType"
      ],
      "additionalProperties": false
    },
    "GraphEncoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "edgeList",
            "adjacencyList",
            "adjacencyMatrix",
            "successor",
            "parent",
            "custom"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "nodeValueType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "edgeValueType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "countParameter": {
          "type": "string",
          "minLength": 1
        },
        "firstNode": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "edgeValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "matrixDiagonal": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/InputPresetConfig"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "InputPresetConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1,
          "description": "Registered input preset ID. Built-ins: default, number, text, boolean, sequence, matrix, tree, linkedList, structured. Server rejects unregistered or codec-incompatible presets."
        },
        "placeholder": {
          "type": "string",
          "maxLength": 512
        },
        "layout": {
          "type": "string",
          "enum": [
            "inline",
            "rows"
          ],
          "description": "Display a two-dimensional array on one line or one row per line. Defaults to inline."
        },
        "showGrid": {
          "type": "boolean",
          "description": "Show a grid from this two-dimensional array in examples and tests."
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "ExecutionLimits": {
      "type": "object",
      "properties": {
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 1
        },
        "maxCollectionElements": {
          "type": "integer",
          "minimum": 1
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "wallTimeMs",
        "memoryBytes",
        "outputBytes",
        "maxProcesses",
        "maxCollectionElements",
        "maxNestingDepth"
      ],
      "additionalProperties": false
    },
    "SqlConfig": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "postgresql"
          ]
        },
        "outputOrder": {
          "type": "string",
          "enum": [
            "ordered",
            "unordered"
          ]
        },
        "tables": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/SqlTableSchema"
          }
        },
        "output": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/SqlColumn"
          }
        }
      },
      "required": [
        "dialect",
        "outputOrder"
      ],
      "additionalProperties": false
    },
    "SqlTableSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/SqlColumn"
          }
        }
      },
      "required": [
        "name",
        "columns"
      ]
    },
    "SqlColumn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "integer",
            "bigint",
            "numeric",
            "text",
            "boolean",
            "date",
            "timestamp",
            "timestamptz",
            "real",
            "double precision"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "AuthoredOdyssey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/AuthoredOdysseyLevel"
          }
        }
      },
      "required": [
        "levels"
      ]
    },
    "AuthoredOdysseyLevel": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "statementMarkdown": {
          "type": "string",
          "description": "Problem Markdown. Use $...$ for formulas, Big O, numbers, arithmetic, comparisons, and mathematical variables such as n. Use backticks for code identifiers, indexing, and property access such as nums[i] and nums.length, even inside a formula. Example: $1 \\le$ `nums[i]` $\\le 50$. Use language-tagged fenced blocks for multiline code or pseudocode and $$ on separate lines for display math."
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signature"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProblemExample"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "hiddenCases": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/CustomCase"
          }
        }
      },
      "required": [
        "title",
        "statementMarkdown",
        "methods",
        "examples",
        "hiddenCases"
      ],
      "additionalProperties": false
    },
    "CustomCase": {
      "type": "object",
      "properties": {
        "graphs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/QuestionGraph"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireValue"
          }
        },
        "expected": {
          "$ref": "#/$defs/WireValue"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodCall"
          }
        }
      },
      "required": [
        "args"
      ],
      "additionalProperties": false
    },
    "SolutionApproach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "explanationMarkdown",
        "timeComplexity",
        "spaceComplexity",
        "complexityNotes",
        "implementations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional for the canonical approach; other approaches require a name."
        },
        "defaultLanguage": {
          "type": "string",
          "enum": [
            "python",
            "java",
            "typescript",
            "ocaml",
            "postgresql"
          ]
        },
        "explanationMarkdown": {
          "type": "string"
        },
        "timeComplexity": {
          "type": "string",
          "description": "Time complexity as LaTeX, for example $O(n \\log n)$."
        },
        "spaceComplexity": {
          "type": "string",
          "description": "Auxiliary space complexity as LaTeX, for example $O(n \\log n)$."
        },
        "complexityNotes": {
          "type": "string"
        },
        "implementations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/SolutionCode"
          }
        }
      }
    },
    "SolutionCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "source"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "python",
            "java",
            "typescript",
            "ocaml",
            "postgresql"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
