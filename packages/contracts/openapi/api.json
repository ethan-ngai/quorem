  "components": {
    "securitySchemes": {
      "DevelopmentIdentity": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Dev-User",
        "description": "Local development only: alice or bob. Disabled outside development."
      }
    },
    "schemas": {
      "Language": {
        "type": "string",
        "enum": ["python"]
      },
      "Difficulty": {
        "type": "string",
        "enum": ["easy", "medium", "hard"]
      },
      "SubmissionKind": {
        "type": "string",
        "enum": ["run", "submit"]
      },
      "SubmissionState": {
        "type": "string",
        "enum": ["queued", "running", "completed", "cancelled", "failed"]
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "accepted",
          "wrong_answer",
          "syntax_error",
          "runtime_error",
          "time_limit",
          "memory_limit",
          "output_limit",
          "invalid_output"
        ]
      },
      "WireValue": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          {
            "type": "number",
            "not": {
              "type": "integer"
            }
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireValue"
            }
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "unauthenticated",
                  "forbidden",
                  "not_found",
                  "user_busy",
                  "invalid_transition",
                  "idempotency_conflict",
                  "stale_session_save",
                  "payload_too_large",
                  "quota_exceeded",
                  "queue_saturated",
                  "temporarily_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "InputPresetConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset"],
        "properties": {
          "preset": {
            "type": "string",
            "minLength": 1,
            "description": "Registered input preset ID. Built-ins: default, number, text, boolean, sequence, matrix, tree, linkedList, structured. Server rejects unregistered or codec-incompatible presets."
          },
          "placeholder": {
            "type": "string",
            "maxLength": 512
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      },
      "Parameter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/InputPresetConfig"
          }
        },
        "required": ["name", "type"],
        "additionalProperties": false
      },
      "Signature": {
        "type": "object",
        "properties": {
          "className": {
            "type": "string",
            "enum": ["Solution"]
          },
          "methodName": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Parameter"
            }
          },
          "returnType": {
            "type": "string"
          }
        },
        "required": ["className", "methodName", "parameters", "returnType"],
        "additionalProperties": false
      },
      "ExecutionLimits": {
        "type": "object",
        "properties": {
          "wallTimeMs": {
            "type": "integer",
            "minimum": 1
          },
          "memoryBytes": {
            "type": "integer",
            "minimum": 1
          },
          "outputBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxProcesses": {
            "type": "integer",
            "minimum": 1
          },
          "maxCollectionElements": {
            "type": "integer",
            "minimum": 1
          },
          "maxNestingDepth": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "wallTimeMs",
          "memoryBytes",
          "outputBytes",
          "maxProcesses",
          "maxCollectionElements",
          "maxNestingDepth"
        ],
        "additionalProperties": false
      },
      "CustomCase": {
        "type": "object",
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireValue"
            }
          },
          "expected": {
            "$ref": "#/components/schemas/WireValue"
          }
        },
        "required": ["args"],
        "additionalProperties": false
      },
      "ProblemExample": {
        "type": "object",
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireValue"
            }
          },
          "expected": {
            "$ref": "#/components/schemas/WireValue"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": ["args", "expected"],
        "additionalProperties": false
      },
      "ProblemVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "title": {
            "type": "string"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statementMarkdown": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemExample"
            }
          },
          "constraints": {
            "type": "array",
