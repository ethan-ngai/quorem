FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68 AS dependencies
WORKDIR /app
RUN npm install --global vite-plus@1.5.1
COPY . .
RUN vp install -- --frozen-lockfile --filter @quorem/auth... --prod
FROM node:26.13.0-bookworm-slim@sha256:add5c17c14752c54d2f3d519ec46a3815684d41c33f198bcb09fb998f7dcbf68
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies --chown=node:node /app /app
USER node
CMD ["node", "--experimental-strip-types", "apps/auth/src/image-service-main.ts"]
