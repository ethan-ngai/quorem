FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS dependencies
WORKDIR /app
RUN npm install --global vite-plus@1.5.1
COPY . .
RUN vp install -- --frozen-lockfile --filter @quorem/auth... --prod
FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies --chown=node:node /app /app
USER node
CMD ["node", "--experimental-strip-types", "apps/auth/src/mail-relay.ts"]
