FROM golang:1.27.1-bookworm AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY apps/api apps/api
COPY apps/runner apps/runner
COPY internal internal
RUN CGO_ENABLED=0 go build -o /out/runner ./apps/runner/cmd/runner

FROM docker:29.9.2-dind AS docker-engine
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=docker-engine /usr/local/bin/ /usr/local/bin/
WORKDIR /app
COPY --from=go-build /out bin
COPY deploy/images images
COPY deploy/judge-start.py deploy/judge-start.py
ENV APP_ENV=production RUNNER_ADDR=0.0.0.0:8090 QUOREM_DATABASE_MAX_CONNS=2 \
    RUNNER_IMAGE=quorem-python:production RUNNER_JAVA_IMAGE=quorem-java:production \
    RUNNER_TYPESCRIPT_IMAGE=quorem-typescript:production RUNNER_OCAML_IMAGE=quorem-ocaml:production \
    RUNNER_POSTGRES_IMAGE=quorem-postgres:production \
    RUNNER_CONCURRENCY=2
EXPOSE 8090
ENTRYPOINT ["python3", "/app/deploy/judge-start.py"]
