FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY apps/api apps/api
COPY apps/runner apps/runner
COPY internal internal
RUN CGO_ENABLED=0 go build -o /out/runner ./apps/runner/cmd/runner

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/runner /app/bin/runner
COPY deploy/direct-judge-start.py /app/deploy/direct-judge-start.py
ENV APP_ENV=production RUNNER_ADDR=0.0.0.0:8090 QUOREM_DATABASE_MAX_CONNS=2 RUNNER_CONCURRENCY=2
EXPOSE 8090
ENTRYPOINT ["python3", "/app/deploy/direct-judge-start.py"]
